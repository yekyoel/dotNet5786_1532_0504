<Window x:Class="PL.Delivery.DeliveryListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Delivery"
        mc:Ignorable="d"
        Title="Delivery Management" Height="600" Width="1000"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded" Closed="Window_Closed"
        Background="{StaticResource MainBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter and Action Buttons Section -->
        <Grid Grid.Row="0" Margin="10" Background="{StaticResource CardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter by Status -->
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="Filter by Status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="150"
                          ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionsKey}}"
                          SelectedValue="{Binding FilterStatus, Mode=TwoWay}"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>

            <!-- Add New Delivery Button -->
            <Button Grid.Column="2"
                    Content="Add Delivery"
                    Margin="10"
                    Click="btnAdd_Click"/>
        </Grid>

        <!-- Deliveries DataGrid -->
        <DataGrid Grid.Row="1"
                  Margin="10"
                  ItemsSource="{Binding DeliveryList}"
                  SelectedItem="{Binding SelectedDelivery}"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Background="{StaticResource CardBackgroundBrush}"
                  SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding OrderId}" Header="ID" Width="60"/>
                <DataGridTextColumn Binding="{Binding OrderStatus}" Header="Status" Width="100"/>
                <DataGridTextColumn Binding="{Binding OrderType}" Header="Type" Width="100"/>
                <DataGridTextColumn Binding="{Binding AerialDistance, StringFormat=N2}" Header="Distance (km)" Width="100"/>
                <DataGridTextColumn Binding="{Binding TotalDeliveries}" Header="Deliveries" Width="80"/>
                <DataGridTextColumn Binding="{Binding TotalTimeLeft}" Header="Time Left" Width="100"/>
                
                <!-- Cancel Button Column -->
                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Cancel"
                                    Click="btnCancel_Click"
                                    Tag="{Binding OrderId}"
                                    FontSize="11"
                                    Padding="5,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
