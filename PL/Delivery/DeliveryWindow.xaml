<Window x:Class="PL.Delivery.DeliveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PL.Delivery"
    mc:Ignorable="d"
    Title="Delivery Details" Height="600" Width="900"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="Window_Loaded"
    Closed="Window_Closed"
    Background="{StaticResource MainBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Styles copied/adapted from CourierWindow -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#262641"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
        </Style>

        <Style x:Key="MainSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#262641"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Section -->
        <Border Grid.Row="0" Style="{StaticResource MainSectionBorderStyle}" Margin="10,10,10,5">
            <TextBlock Text="Delivery Details" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
        </Border>

        <!-- Main Content Section -->
        <Border Grid.Row="1" Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Order Details -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="General Information" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Delivery ID:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" 
                                 IsReadOnly="True"
                                 Text="{Binding CurrentDelivery.Id, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Customer Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" 
                                 Text="{Binding CurrentDelivery.CustomerName, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsUpdateMode}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Customer Phone:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" 
                                 Text="{Binding CurrentDelivery.CustomerPhone, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsUpdateMode}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Address:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" 
                                 Text="{Binding CurrentDelivery.OrderAddress, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsUpdateMode}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Description:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" 
                                 Text="{Binding CurrentDelivery.Description, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsUpdateMode}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Status:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource TextBoxStyle}" 
                                 IsReadOnly="True"
                                 Text="{Binding CurrentDelivery.OrderStatus, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Column: Delivery History -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Delivery History" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CurrentDelivery.DeliveriesList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#1a2a2e"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding DeliveryId}" Header="ID" Width="50"/>
                            <DataGridTextColumn Binding="{Binding CourierName}" Header="Courier" Width="*"/>
                            <DataGridTextColumn Binding="{Binding CompType}" Header="Status" Width="80"/>
                            <DataGridTextColumn Binding="{Binding DeliveryEndTime, StringFormat='{}{0:dd/MM HH:mm}'}" Header="End Time" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- Buttons Section -->
        <Border Grid.Row="2" Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding ButtonText}" 
                        Width="120" Height="40" 
                        Click="btnAddUpdate_Click" 
                        Margin="0,0,10,0"/>
                
                <Button Content="Cancel Delivery" 
                        Width="120" Height="40" 
                        Click="btnCancel_Click" 
                        Margin="0,0,10,0"
                        Visibility="{Binding IsUpdateMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <Button Content="Close" 
                        Width="120" Height="40" 
                        Click="btnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
