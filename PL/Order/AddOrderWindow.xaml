<Window x:Class="PL.Order.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="Add Order" Height="655" Width="900"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Background="{StaticResource MainBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource MainBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Margin="15" Background="#262641" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="2" CornerRadius="8" Padding="20">
            <TextBlock Text="Add New Order" FontSize="28" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Margin="15,0,15,10" Background="#262641" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="2" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LEFT COLUMN -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Order ID (readonly, will be assigned by DAL) -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Order ID:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxStyle}" 
                                 Text="{Binding NewOrder.Id, Mode=OneWay}"/>

                        <!-- Customer Name -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Customer Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.CustomerName, Mode=TwoWay}"/>

                        <!-- Customer Phone -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Customer Phone:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.CustomerPhone, Mode=TwoWay}"/>

                        <!-- Order Address -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Order Address:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.OrderAddress, Mode=TwoWay}"/>

                        <!-- Weight -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Weight (kg):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.Weight, Mode=TwoWay}"/>

                        <!-- Latitude -->
                        <Label Grid.Row="5" Grid.Column="0" Content="Latitude:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.Latitude, Mode=TwoWay}"/>
                    </Grid>

                    <!-- RIGHT COLUMN -->
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Order Type -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Order Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"  Margin="0,0,0,12"
                                  ItemsSource="{Binding Source={StaticResource OrderTypeCollectionsKey}}"
                                  SelectedValue="{Binding NewOrder.OrderTyype, Mode=TwoWay}"/>

                        <!-- Longitude -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Longitude:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.Longitude, Mode=TwoWay}"/>

                        <!-- Description -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Description:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding NewOrder.Description, Mode=TwoWay}"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Margin="15" Background="#262641" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="2" CornerRadius="8" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Width="130" Height="45" Margin="0,0,15,0" Click="btnAdd_Click"/>
                <Button Content="Close" Width="130" Height="45" Click="btnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
