<Window x:Class="PL.MainWindow"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        
        Title="MainWindow"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed"
        Background="{StaticResource MainBackgroundBrush}"
        
        d:DesignHeight="1080"
        d:DesignWidth="1920">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="170*"/>
            <RowDefinition Height="350*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>

        <!--the clock section-->
        <Grid Background="{StaticResource CardBackgroundBrush}" HorizontalAlignment="Stretch" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Time -->
            <Viewbox Grid.Column="0" Margin="20,0">
                <Label Content="{Binding CurrentTime}" FontFamily="Segoe UI"  FontWeight="ExtraBlack"  VerticalAlignment="Center"  HorizontalAlignment="Center"/>
            </Viewbox>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,30,0">
                <Button Content="+Minute" Click="btnAddOneMin_Click" MinWidth="90" Height="45" FontSize="14" Margin="10,0,10,0" Padding="12,4"/>
                <Button Content="+Hour"   Click="btnAddOneHr_Click" MinWidth="90" Height="45" FontSize="14" Margin="10,0,10,0" Padding="12,4"/>
                <Button Content="+Day"    Click="btnAddOneDay_Click"  MinWidth="90" Height="45" FontSize="14" Margin="10,0,10,0" Padding="12,4"/>
                <Button Content="+Month"  Click="btnAddOneMon_Click" MinWidth="90" Height="45" FontSize="14" Margin="10,0,10,0" Padding="12,4"/>
                <Button Content="+Year"   Click="btnAddOneYr_Click"  MinWidth="90" Height="45" FontSize="14" Margin="10,0,10,0" Padding="12,4"/>
            </StackPanel>
        </Grid>
        
        <!-- Order Summary Section -->
        <Grid Grid.Row="1" Margin="20">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Order Summary" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                    <UniformGrid Columns="4" Rows="2" Margin="0,10,0,0">
                        <Button Content="{Binding OpenOnTimeText}" Margin="10" Click="BtnOpenOnTime_Click" FontSize="14" Height="20"/>
                        <Button Content="{Binding OpenInRiskText}" Margin="10" Click="BtnOpenInRisk_Click" FontSize="14" Height="20"/>
                        <Button Content="{Binding OpenLateText}" Margin="10" Click="BtnOpenLate_Click" FontSize="14" Height="20"/>
                        <Button Content="{Binding CompletedOnTimeText}" Margin="10" Click="BtnCompletedOnTime_Click" FontSize="14" Height="20"/>
                        <Button Content="{Binding CompletedLateText}" Margin="10" Click="BtnCompletedLate_Click" FontSize="14" Height="20"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid> 

        <!--Configuration variables-->
        <Grid Grid.Row="2" Margin="20">
            <Border Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
               
                    </Grid.Resources> 

                    <!-- Row 0: Admin ID, Company Name, Car Speed -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Admin ID:"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Configuration.AdminId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Company Name:"/>
                    <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding Configuration.CompanyName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <TextBlock Grid.Row="0" Grid.Column="8" Text="Avg Car MPH:"/>
                    <TextBox Grid.Row="0" Grid.Column="10" Text="{Binding Configuration.AvgCarMPH, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <!-- Row 1: Max Distance, Motorcycle Speed, Bicycle Speed -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Distance:"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Configuration.MaxDist, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Avg Motorcycle MPH:" />
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding Configuration.AvgMotorcycleMPH, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <TextBlock Grid.Row="1" Grid.Column="8" Text="Avg Bicycle MPH:"/>
                    <TextBox Grid.Row="1" Grid.Column="10" Text="{Binding Configuration.AvgBicycleMPH, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <!-- Row 2: Walk Speed, Down Time, Max Del Time, Risk Range -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Avg Walk MPH:"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Configuration.AvgWalkMPH, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Down Time:"/>
                    <TextBox Grid.Row="2" Grid.Column="6" Text="{Binding Configuration.DownTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <TextBlock Grid.Row="2" Grid.Column="8" Text="Max Del Time:"/>
                    <TextBox Grid.Row="2" Grid.Column="10" Text="{Binding Configuration.MaxDelTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />


                    <TextBlock Grid.Row="3"  Grid.Column="0" Text="Risk Range:"/>
                    <TextBox  Grid.Row="3" Grid.Column="2" Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                               MinHeight="40" VerticalAlignment="Center" Margin="0,10,10,10" FontSize="14" />

                    <Button Grid.Row="3" Grid.Column="8" Content="Set Config Values"   HorizontalAlignment="Right" Click="btnUpdateObj_Click" 
                            Height="50" Margin="0,5,10,10" MinWidth="150" FontSize="14" FontWeight="Bold"/>

                </Grid>
            </Border>
        </Grid>
            
        <!-- General Bottons-->
        <Grid Grid.Row="3" Background="{StaticResource CardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Content="Initialize" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnInitialize_Click"
                    MinWidth="140" Height="45" FontSize="16" Margin="10,6,10,0" Padding="12,4"/>
            
            <Button Content="Reset DB"   Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnResetDB_Click"
                    MinWidth="140" Height="45" FontSize="16" Margin="10,6,10,0" Padding="12,4"/>

            <Button Content="View CourierLists" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnCourierListDisplay_Click"
                    MinWidth="160" Height="45" FontSize="16" Margin="10,6,10,0" Padding="12,4"/>
            
            <Button Content="View OrderLists"   Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"  Click="btnOrderListDisplay_Click"
                    MinWidth="160" Height="45" FontSize="16" Margin="10,6,10,0" Padding="12,4"/>
        </Grid>

    </Grid>
</Window>

