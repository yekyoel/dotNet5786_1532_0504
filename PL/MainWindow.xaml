<Window x:Class="PL.MainWindow"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <!--the clock section-->
        <Grid  Margin="10,0,10,380">
            <Label Content="{Binding CurrentTime}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="30" Width="200" />
        
            <Button Content="Add Second" HorizontalAlignment="Left" Margin="235,10,0,0" VerticalAlignment="Top" Height="30" Width="70" Click="btnAddOneSec_Click" />
            <Button Content="Add Minute" HorizontalAlignment="Left" Margin="315,10,0,0" VerticalAlignment="Top" Height="30" Width="70" Click="btnAddOneMin_Click" />
            <Button Content="Add Hour" HorizontalAlignment="Left" Margin="395,10,0,0" VerticalAlignment="Top" Height="30" Width="70" Click="btnAddOneHr_Click" />
            <Button Content="Add Day" HorizontalAlignment="Left" Margin="475,10,0,0" VerticalAlignment="Top" Height="30" Width="70" Click="btnAddOneDay_Click" />
            <Button Content="Add Year" HorizontalAlignment="Left" Margin="555,10,0,0" VerticalAlignment="Top" Height="30" Width="70" Click="btnAddOneYr_Click" />
        </Grid>
        
        <!--Configuration variables-->
        <Grid Margin="10,60,10,84">
            <StackPanel>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.AdminId, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.MaxDist, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.AvgCarMPH, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.AvgMotorcycleMPH, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.AvgBicycleMPH, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.AvgWalkMPH, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            
            <StackPanel Margin="250,0,0,0">
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.MaxDelTime, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                         Text="{Binding Configuration.DownTime, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Button" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120"
                        Click="btnCreateObj_Click"/>
            </StackPanel>

            
        </Grid>

        <!-- General Bottons-->
        <Grid Margin="10,375,10,10">
            <Button Content="Initialize" HorizontalAlignment="Left" Margin="90,20,0,0" VerticalAlignment="Top"/>
            <Button Content="Rest DB" HorizontalAlignment="Left" Margin="213,20,0,0" VerticalAlignment="Top"/>
            <Button Content="List Display" HorizontalAlignment="Left" Margin="400,20,0,0" VerticalAlignment="Top"/>
        </Grid>

    </Grid>
</Window>
