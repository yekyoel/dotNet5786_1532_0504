<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f0f">
    
    <!-- Main Grid with Dark Background -->
    <Grid>
        <!-- Dark Background with subtle gradient -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f0f0f" Offset="0"/>
                    <GradientStop Color="#1a1a2e" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Two Column Layout -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side - Branding/Info Section -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="FAST FOOD FOR YOU" 
                           FontSize="27" 
                           FontWeight="Bold" 
                           Foreground="#00d4ff"
                           TextAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock Text="System Management" 
                           FontSize="17" 
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,5,0,10"/>

                <Rectangle Height="1.5" Fill="#00d4ff" Width="170" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                
                <TextBlock FontSize="10" 
                           Foreground="#888888"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="16">
                    Manage Couriers, Orders, and Deliveries 
                </TextBlock>
            </StackPanel>

            <!-- Right Side - Login Card -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="342" Margin="0,0,0,0">
                <!-- Dark Card -->
                <Border Background="#1a2a2e" 
                        Padding="32,32,32,32"
                        Margin="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <!-- Glowing Icon/Circle -->
                        <Ellipse Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00d4ff" Offset="0"/>
                                    <GradientStop Color="#7c3aed" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="13" ShadowDepth="0" Opacity="0.4" Color="#00d4ff"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Title Section -->
                        <TextBlock Text="Welcome Back" 
                                   FontSize="19" 
                                   FontWeight="Bold" 
                                   Foreground="#ffffff"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Sign in" 
                                   FontSize="12" 
                                   Foreground="#888888"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"/>

                        <!-- Divider Line -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16"/>

                        <!-- ID Input Section -->
                        <StackPanel Margin="0,0,0,13">
                            <TextBlock Text="USER ID" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="#00d4ff"
                                       Margin="0,0,0,6"
                                       Opacity="0.9"/>
                            <Border Background="#262641" 
                                    BorderBrush="#00d4ff" 
                                    BorderThickness="1"
                                    Padding="0">
                                <TextBox x:Name="IdTextBox"
                                         FontSize="13"
                                         Padding="13,11,13,11"
                                         Background="Transparent"
                                         Foreground="#ffffff"
                                         CaretBrush="#00d4ff"
                                         BorderThickness="0"
                                         KeyDown="IdTextBox_KeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                                      Background="{TemplateBinding Background}" 
                                                                      Foreground="{TemplateBinding Foreground}"
                                                                      Padding="{TemplateBinding Padding}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>
                        </StackPanel>

                        <!-- Login Button -->
                        <Button x:Name="LoginButton"
                                Content="SIGN IN" 
                                Click="LoginButton_Click"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Padding="11,11,11,11"
                                Foreground="White"
                                BorderThickness="0"
                                Height="38"
                                Cursor="Hand"
                                Margin="0,0,0,13">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00d4ff" Offset="0"/>
                                    <GradientStop Color="#7c3aed" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="#00d4ff"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorMessage" 
                                   Text="" 
                                   Foreground="#ff6b6b" 
                                   FontSize="9"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>

                        <!-- Footer -->
                        <TextBlock FontSize="8" 
                                   Foreground="#666666"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            Demo: <Run Foreground="#00d4ff" FontWeight="Bold">123456789</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
