<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="FAST FOOD FOR YOU" 
                           FontSize="27" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource NeonCyanBrush}"
                           TextAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock Text="System Management" 
                           FontSize="17" 
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,5,0,10"/>

                <Rectangle Height="1.5" Fill="{StaticResource NeonCyanBrush}" Width="170" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock FontSize="10" 
                           Foreground="#888888"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="16">
                    Manage Couriers, Orders, and Deliveries
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="342">

                <Border Style="{StaticResource CardStyle}" Padding="32" Margin="15">

                    <StackPanel>
                        <Ellipse Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00d4ff" Offset="0"/>
                                    <GradientStop Color="#7c3aed" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="13" ShadowDepth="0" Opacity="0.4" Color="#00d4ff"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <TextBlock Text="Welcome Back" 
                                   FontSize="19" 
                                   FontWeight="Bold" 
                                   Foreground="#ffffff"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Sign in" 
                                   FontSize="12" 
                                   Foreground="#888888"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16"/>

                        <Rectangle Height="1" Fill="#333333" Margin="0,0,0,16"/>

                        <StackPanel Margin="0,0,0,13">
                            <TextBlock Text="USER ID" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource NeonCyanBrush}"
                                       Margin="0,0,0,6"
                                       Opacity="0.9"/>

                            <TextBox x:Name="IdTextBox"
                                     FontSize="13"
                                     KeyDown="IdTextBox_KeyDown"
                                     Margin="0"/>
                        </StackPanel>

                        <Button x:Name="LoginButton"
                                Content="SIGN IN" 
                                Click="LoginButton_Click"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Height="38"
                                Margin="0,0,0,13"/>

                        <TextBlock x:Name="ErrorMessage" 
                                   Text="" 
                                   Foreground="#ff6b6b" 
                                   FontSize="9"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>

                        <TextBlock FontSize="8" 
                                   Foreground="#666666"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            Demo: <Run Foreground="{StaticResource NeonCyanBrush}" FontWeight="Bold">123456789</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>