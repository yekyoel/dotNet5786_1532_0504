<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="CourierListWindow" Height="450" Width="1000"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded" Closed="Window_Closed" 
        Background="{StaticResource MainBackgroundBrush}">
    
    <!-- Main Grid layout with 2 rows: Filter/Buttons section and DataGrid -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Filter ComboBox and Add Button -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Courier DataGrid (takes remaining space) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Filter and Action Buttons Section -->
        <Grid Grid.Row="0" Margin="5" Background="{StaticResource CardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Filter ComboBox (fills available space) -->
                <ColumnDefinition Width="*"/>
                <!-- Column 1: Add Button (auto-sized) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Filter Section -->
            <Grid Grid.Column="0" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0" Content="Filter by Shipping Method:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                
                <!-- Filter by Shipping Method ComboBox
                     - Binds to VehicleTypeCollectionsKey resource for available shipping methods
                     - SelectedValue binds to FilterShippingMethods property in code-behind
                     - SelectionChanged event triggers list filtering
                     - Custom style to change background color -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionsKey}}"
                          VerticalAlignment="Center"
                          SelectedValue="{Binding FilterShippingMethods, Mode=TwoWay}" 
                          SelectionChanged="ComboBox_SelectionChanged">
                </ComboBox>
            </Grid>
            
            <!-- Add New Courier Button
                 - Opens CourierWindow in "Add" mode (new courier) -->
            <Button Grid.Column="1"
                    Content="Add Courier"
                    Margin="5,0,0,0"
                    Padding="15,5"
                    HorizontalAlignment="Right"
                    Click="btnAdd_Click" 
                    MinWidth="100"/>
        </Grid>
        
        <!-- Couriers DataGrid
             - Displays list of all couriers with their details
             - IsReadOnly: Prevents inline editing
             - RowDetailsVisibilityMode: Shows details when row is selected
             - MouseDoubleClick: Opens CourierWindow in "Update" mode for selected courier
             - EnableRowVirtualization: Improves performance with large datasets -->
        <DataGrid Grid.Row="1" 
                  Margin="5" 
                  ItemsSource="{Binding CourierList}" 
                  SelectedItem="{Binding SelectedCouriers}" 
                  MouseDoubleClick="lsvCouriersList_MouseDoubleClick"
                  IsReadOnly="True" 
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True" 
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Background="{StaticResource CardBackgroundBrush}" 
                  SelectionChanged="DataGrid_SelectionChanged">
            
            <!-- DataGrid Columns Definition -->
            <DataGrid.Columns>
                <!-- Courier ID Column - Auto-sized based on content -->
                <DataGridTextColumn Binding="{Binding CourierId}" Header="Courier ID" Width="*"/>
                
                <!-- Full Name Column - Takes remaining horizontal space -->
                <DataGridTextColumn Binding="{Binding FullName}" Header="Full Name" Width="1.5*"/>
                
                <!-- Is Active Status Column
                     - Uses CheckBox template (read-only)
                     - Shows courier's active status at a glance -->
                <DataGridTemplateColumn Header="Is Active" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsEnabled="False" IsChecked="{Binding Path=IsActive}" 
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Shipping Method Column - Shows preferred delivery method (Car, Motorcycle, Bike, OnFoot) -->
                <DataGridTextColumn Binding="{Binding ShippingMethod}" Header="Shipping Method" Width="*"/>
                
                <!-- Employment Date Column - Formatted as DD/MM/YYYY -->
                <DataGridTextColumn Binding="{Binding EmploymentStartDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                    Header="Employment Date" Width="*"/>
                
                <!-- On-Time Deliveries Column - Displays count of successful on-time deliveries -->
                <DataGridTextColumn Binding="{Binding TotalDelSuppliedOnTime}" 
                                    Header="On Time Deliveries" Width="*"/>
                
                <!-- Late Deliveries Column
                     - Uses custom template with red text to highlight performance issues
                     - Bold font makes it stand out -->
                <DataGridTemplateColumn Header="Late Deliveries" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalLateDelSupplied}" 
                                       Foreground="Red" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Current Order ID Column - Shows the order currently being handled by this courier -->
                <DataGridTextColumn Binding="{Binding OrderId}" Header="Current Order ID" Width="*"/>
                
                <!-- Actions Column - Delete Button
                     - Each row has a "Delete" button
                     - Tag stores the CourierId for identifying which courier to delete
                     - Click handler triggers delete confirmation dialog -->
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" 
                                    Padding="8,4"
                                    Background="{StaticResource ButtonGradientBrush}"
                                    Foreground="White"
                                    Click="btnDelete_Click"
                                    Tag="{Binding CourierId}"
                                    IsEnabled="{Binding CourierId, Converter={StaticResource CanDeleteCourierConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="Gray"/>
                                                <Setter Property="Foreground" Value="LightGray"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                         </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
