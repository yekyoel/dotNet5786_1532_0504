<Window x:Class="PL.Courier.CourierScreens.CourierMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier.CourierScreens"
        mc:Ignorable="d"
        Title="Courier Main Window"
        Height="650"
        Width="900"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MainSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#262641"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource MainBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource MainSectionBorderStyle}" Margin="10,10,10,5">
            <TextBlock Text="Courier" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,5">
            <StackPanel Margin="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Courier ID:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     IsReadOnly="True"
                                     Text="{Binding CurrentCourier.Id, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Full Name:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Phone Number:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Email:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Is Active:" Style="{StaticResource LabelStyle}"/>
                            <CheckBox Style="{StaticResource CheckBoxStyle}"
                                      IsEnabled="False"
                                      IsChecked="{Binding CurrentCourier.IsActive, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Max Distance (km):" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding CurrentCourier.MaxDist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Shipping Method:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox MinWidth="150"
                                      ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionsKey}}"
                                      SelectedValue="{Binding CurrentCourier.ShippingMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Employment Date:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Style="{StaticResource DatePickerStyle}"
                                        IsEnabled="False"
                                        SelectedDate="{Binding CurrentCourier.EmploymentStartDate, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="On-Time Deliveries:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     IsReadOnly="True"
                                     Text="{Binding CurrentCourier.TotalDelSuppliedOnTime, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Late Deliveries:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     IsReadOnly="True"
                                     Text="{Binding CurrentCourier.TotalDelSuppliedLate, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Current order (view only) -->
        <Border Grid.Row="2" Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,5">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <TextBlock Text="Current Order In Progress"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource NeonCyanBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Visibility="{Binding HasOrderInProgress, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Order ID:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.OrderId, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Customer:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.CustomerName, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Customer Phone:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.CustomerNumber, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Address:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="70"
                                         Text="{Binding CurrentCourier.OrderInProg.DeliveryAddress, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Air Distance (km):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.ArealDistance, Mode=OneWay, StringFormat=N2}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right column -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Time Left:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.TotalTimeLeft, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Order Status:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.OrderStats, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Schedule Status:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding CurrentCourier.OrderInProg.ScheduleStat, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Last Completion:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         Text="{Binding LastCompletionTypeText, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Completion Type:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox MinWidth="150"
                                          Foreground="White"
                                          Background="#262641"
                                          ItemsSource="{Binding CompletionTypes}"
                                          SelectedItem="{Binding SelectedCompletionType, Mode=TwoWay}"
                                          SelectionChanged="CompletionType_SelectionChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Visibility="{Binding HasNoOrderInProgress, Converter={StaticResource BoolToVis}}"
                               Text="No order is currently being handled."
                               Foreground="{StaticResource TextSubBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Update" Width="140" Height="40" Click="btnUpdate_Click" Margin="0,0,10,0"/>
                <Button Content="Select Order" Width="140" Height="40" Click="btnSelectOrder_Click" Margin="0,0,10,0"
                        IsEnabled="{Binding CanSelectOrder}"/>
                <Button Content="Finish Handling" Width="160" Height="40" Click="btnFinishHandling_Click" Margin="0,0,10,0"
                        IsEnabled="{Binding CanFinishHandling}"/>
                <Button Content="Delivery History"
                        Width="160"
                        Height="40"
                        Click="btnDeliveryHistory_Click"
                        Margin="0,0,10,0"/>
                <Button Content="Close" Width="140" Height="40" Click="btnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Loading overlay -->
        <Grid Background="#66000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="280" Height="12"/>
                <TextBlock Text="Loading..." Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
