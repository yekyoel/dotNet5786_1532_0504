<Window x:Class="PL.Courier.CourierWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PL.Courier"
    mc:Ignorable="d"
    Title="Courier Details" Height="500" Width="900"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="Window_Loaded"
    Closed="Window_Closed">

    <Window.Resources>
        <!-- Style for consistent label formatting -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Style for consistent textbox formatting -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Style for consistent combobox formatting -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- Style for consistent checkbox formatting -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style for consistent datepicker formatting -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Main Section Border Style - Applied to top, middle, and bottom sections -->
        <Style x:Key="MainSectionBorderStyle" TargetType="Border">
            <!-- Dark background matching theme -->
            <Setter Property="Background" Value="#262641"/>
            <!-- Cyan border for accent -->
            <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
            <!-- 2px border for visibility -->
            <Setter Property="BorderThickness" Value="2"/>
            <!-- Rounded corners for modern look -->
            <Setter Property="CornerRadius" Value="8"/>
            <!-- Internal padding for spacing -->
            <Setter Property="Padding" Value="15"/>
            <!-- Subtle shadow for depth -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Background="{StaticResource MainBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Section with Border -->
        <Border Grid.Row="0" Style="{StaticResource MainSectionBorderStyle}" Margin="10,10,10,5">
            <TextBlock Text="Courier Details" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
        </Border>

        <!-- Main Content Section with ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,5">
            <StackPanel>
                <!-- Existing courier details -->
                <Border Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,5">
                    <StackPanel Margin="20">
                        <!-- Left and Right Columns -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <!-- ID -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Courier ID:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" 
                                             IsReadOnly="{Binding IsUpdateMode}"
                                             Text="{Binding CurrentCourier.Id, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Full Name -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Full Name:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" 
                                             Text="{Binding CurrentCourier.FullName, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Phone Number -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Phone Number:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" 
                                             Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Email:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" 
                                             Text="{Binding CurrentCourier.Email, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Is Active -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Is Active:" Style="{StaticResource LabelStyle}"/>
                                    <CheckBox Style="{StaticResource CheckBoxStyle}" 
                                              IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Max Distance -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Max Distance (km):" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" 
                                             Text="{Binding CurrentCourier.MaxDist, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <!-- Shipping Method -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Shipping Method:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox MinWidth="150"
                                              ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionsKey}}"
                                              SelectedValue="{Binding CurrentCourier.ShippingMethod, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Employment Start Date -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Employment Date:" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker Style="{StaticResource DatePickerStyle}" 
                                                SelectedDate="{Binding CurrentCourier.EmploymentStartDate, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Total On Time Deliveries (Read-only) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="On-Time Deliveries:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                             Text="{Binding CurrentCourier.TotalDelSuppliedOnTime, Mode=OneWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>

                                <!-- Total Late Deliveries (Read-only) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Label Content="Late Deliveries:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                             Text="{Binding CurrentCourier.TotalDelSuppliedLate, Mode=OneWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Current order (view only) - shown only when viewing/updating an existing courier -->
                <Border Style="{StaticResource MainSectionBorderStyle}"
                        Margin="10,5,10,5"
                        Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <TextBlock Text="Current Order In Progress"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource NeonCyanBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid Visibility="{Binding HasOrderInProgress, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left column -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Order ID:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.OrderId, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Customer:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.CustomerName, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Customer Phone:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.CustomerNumber, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Address:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Height="70"
                                                 Text="{Binding CurrentCourier.OrderInProg.DeliveryAddress, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Air Distance (km):" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.ArealDistance, Mode=OneWay, StringFormat=N2}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right column -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Time Left:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.TotalTimeLeft, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Order Status:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.OrderStats, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Schedule Status:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding CurrentCourier.OrderInProg.ScheduleStat, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Last Completion:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding LastCompletionTypeText, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="Completion Type:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 Text="{Binding SelectedCompletionType, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Visibility="{Binding HasNoOrderInProgress, Converter={StaticResource BoolToVis}}"
                                       Text="No order is currently being handled."
                                       Foreground="{StaticResource TextSubBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons Section with Border - Centered -->
        <Border Grid.Row="2" Style="{StaticResource MainSectionBorderStyle}" Margin="10,5,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding ButtonText}" Width="120" Height="40" Click="btnAddUpdate_Click" Margin="0,0,10,0"/>
                <Button Content="Close" Width="120" Height="40" Click="btnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
