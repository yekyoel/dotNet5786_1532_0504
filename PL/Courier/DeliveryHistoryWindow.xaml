<Window x:Class="PL.Courier.CourierScreens.DeliveryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier.CourierScreens"
        mc:Ignorable="d"
        Title="Delivery History" Height="500" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Background="{StaticResource MainBackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="My Delivery History" FontSize="24" FontWeight="Bold" 
                   Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryList}" AutoGenerateColumns="False" IsReadOnly="True" Background="#1a2a2e">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding DeliveryId}" Header="ID" Width="50"/>
                <DataGridTextColumn Binding="{Binding DeliveryAddress}" Header="Address" Width="*"/>
                <DataGridTextColumn Binding="{Binding ActualDistance, StringFormat=N2}" Header="Distance (km)" Width="100"/>
                <DataGridTextColumn Binding="{Binding CompletionType}" Header="Status" Width="100"/>
                <DataGridTextColumn Binding="{Binding TotalCompletionTime}" Header="Duration" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" Click="btnClose_Click" Width="100" Height="30" Margin="0,10,0,0"/>
    </Grid>
</Window>
